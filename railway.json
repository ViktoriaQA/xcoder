{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "/backend/**",
      "/frontend/**",
      "/Dockerfile",
      "/package.json"
    ]
  },
  "deploy": {
    "startCommand": "node --max-old-space-size=384 dist/index.js",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "numReplicas": 1,
    "overlapSeconds": 0,
    "drainingSeconds": 10
  }
}
